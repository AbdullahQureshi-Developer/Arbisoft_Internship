cat > .gitignore << 'EOF'
# Virtual environments
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.pyc
*.pyo

# Testing / linting caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Databases / local data
*.sqlite3
chroma_db/
chroma_db_compare/

# Logs
*.log

# Environment variables
.env

# OS files
.DS_Store
Thumbs.db
EOF